rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 任何人可讀取圖片
    match /{allPaths=**} {
      allow read: if true;
      // 僅限管理員帳號上傳 10MB 以下的圖片檔
      allow write: if request.auth != null
                   && request.auth.token.email == 'elvis814@gmail.com'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
