rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 所有人可讀取（前台公開）
    // 僅限管理員帳號可寫入
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'elvis814@gmail.com';
    }
  }
}
